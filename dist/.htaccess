# 404 page (dist/404.html; its URLs are root-relative)
ErrorDocument 404 /404.html

# Carried-forward redirects: the live site's own aliases (see audit/redirects.json)
RedirectMatch 301 ^/appointment-request-form/?$ /contact-us/appointment-request-form/
RedirectMatch 301 ^/contact-us/patient-forms/new-patient-information/?$ /riverside-family-eyecares-guide-to-visual-hygiene-on-electronic-devices/
