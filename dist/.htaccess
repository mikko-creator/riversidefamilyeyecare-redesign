RedirectMatch 301 ^/eyeglasses-contacts/eyeglasses/specialty-eyewear/?$ /riverside-family-eyecares-guide-to-visual-hygiene-on-electronic-devices/
RedirectMatch 301 ^/new-patient-information/?$ /contact-us/appointment-request-form/
