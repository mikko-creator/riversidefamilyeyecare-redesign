RedirectMatch 301 ^/eye-emergencies-pink-red-eyes/?$ /eye-care-services/eye-emergencies-pink-red-eyes/
RedirectMatch 301 ^/eyeglasses-contacts/contact-lenses/?$ /contact-lenses/
RedirectMatch 301 ^/eyeglasses-contacts/eyeglasses/?$ /eyeglasses/
RedirectMatch 301 ^/eyeglasses-contacts/eyeglasses/designer-frames/?$ /riverside-family-eyecares-guide-to-visual-hygiene-on-electronic-devices/
