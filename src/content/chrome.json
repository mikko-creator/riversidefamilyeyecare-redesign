  "notice": null,
  "authored": [
    {
      "field": "logo.homeLabel",
      "why": "non-visible aria-label for the logo link; the source link has none (its img alt names it). R precedent: COMPONENTS.md H.2. Riverside decision pending."
    },
    {
      "field": "mapsLinkLabel",
      "why": "fallback link text if the keyless map does not resolve. R precedent: BUILD-DECISIONS #10. Riverside decision pending."
    },
    {
      "field": "mapQuery",
      "why": "composed from the verified NAP parts (brandName, address.*): the keyless maps?q= endpoint cannot resolve the source's place_id (R's PORT-NOTES F4)."
    }
  ],
  "changes": [
    {
      "id": "C01",
      "what": "top-bar call button: tel: 239-500-2020 (space after \"tel:\") -> tel:239-500-2020, the form the mobile header, sidebar and footer NAP already use (R ledger L17)"
    },
    {
      "id": "C02",
      "what": "not carried into the chrome (R ledger L11 class; the design ledger must confirm): footer voice search (\"Speak Field\"), sidebar search widget, \"Powered by\" + EyeCarePro logo (the \"© 2026\" stays), the Login link (https://riversidefamilyeyecare.ecpbuilder.com/wp-admin), \"Return to top of menu\" focus traps, the GTM noscript iframe"
    },
    {
      "id": "R01",
      "what": "restructure 2026-10-07 (operator: copy the site structure of https://eyetrendsclearlake.com/): the primary menu, footer columns and legal links follow the Eye Trends menus and labels, every href a path of the restructured site (src/lib/restructure.mjs). The source menus are kept unchanged in navSource and footerSource."
    }
  ],
  "extensions": [
    "nav[].children: the source menu has sub-menus (3 of 6 top items); every item carries children ([] when none). R's templates render only the top level.",
    "fax, email, sidebar.location.faxLabel / emailLabel / emailNote: the sidebar location widget prints Fax and Email (R's printed neither).",
    "sidebar.insurance = null: Riverside's sidebar has no insurance text widget; R's aside() reads sidebar.insurance.paras and must skip a null. sidebar.social: the sidebar prints the same four icons as footer.social.",
    "logo.srcPatternMobile: the mobile header uses a different logo file (and alt) from the desktop header.",
    "mobileHeader.appointment.newTab (source target=\"_blank\"); mobileHeader.menu = \"nav\": the hamburger prints the same tree as nav.",
    "mapPlaceId: the source map embeds Google place_id (keyed embed/v1); kept as evidence, not used by the keyless embed.",
    "quickActions[].sourceIcon: the source data-icon behind the mapped icon name.",
    "footer.columns[0].title = null: the source footer menu has no heading, and there is one column (R has two; its footer() reads columns[1]).",
    "footer.nap.postalEnd / phoneEnd / site / text: the source NAP line ends the ZIP and the phone with \".\" and adds the site URL; text is the whole line as printed, the oracle write-facts compares against.",
    "footer.button: the footer prints a Request Appointment button.",
    "footer.social: four networks (facebook, yelp, google, youtube); R's footer() draws every icon with the facebook glyph.",
    "notice = null: the form notice is a build decision Riverside has not made (R: BUILD-DECISIONS #4)."
  ],
